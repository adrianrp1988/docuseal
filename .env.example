# LDAP (optional)

LDAP integration is optional and disabled by default. When enabled, Docuseal will attempt to authenticate users against an LDAP server before falling back to local database authentication.

# Enable LDAP
LDAP_ENABLED=false
LDAP_HOST=ldap.example.org
LDAP_PORT=389
LDAP_BASE_DN=dc=example,dc=org
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_UID_ATTRIBUTE=uid
LDAP_CREATE_USERS=true
LDAP_ENCRYPTION=none
LDAP_FALLBACK=true
